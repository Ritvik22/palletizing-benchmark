# Production origin. Google callback: https://palletizing-benchmark.org/api/auth/google/callback
PUBLIC_ORIGIN=https://palletizing-benchmark.org
# Never enable on a public host. For loopback-only development use 1.
LOCAL_ADMIN_LOGIN=0
# Persist this path outside ephemeral deployment storage; back it up.
COMPETITION_DB=/data/competition.sqlite
BIND_HOST=0.0.0.0
PORT=8769
# Configure in your host's secret manager; never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
